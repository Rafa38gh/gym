<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Cadastro</title>
</head>
<body>
    
    <div class = "container">
        <h1>Criar Conta</h1>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-error">
                <%= error %>
            </div>
        <% } %>

        <form id="registerForm" method="post" action="/api/users/register">
            <div>
                <label for="nome">Nome</label>
                <input type="text" id="nome" name="nome" placeholder="Seu nome completo" value="<%= typeof nome !== 'undefined' ? nome : '' %>" required>

                <div class="error-message" id="nomeError"></div>
            </div>

            <br>

            <div>
                <label for="email">Email</label>
                <input type="email" id="email" name="email" placeholder="seu@email.com" value="<%= typeof email !== 'undefined' ? email : '' %>" required>

                <div class="error-message" id="emailError"></div>
            </div>

            <br>

            <div>
                <label for="senha">Senha</label>
                <input type="password" id="senha" name="senha" placeholder="Mínimo 6 caracteres" required minlength="6">

                <div class="error-message" id="senhaError"></div>
                <div class="password-strength" id="passwordStrength"></div>
            </div>

            <br>

            <div>
                <label for="confirmarSenha">Confirmar Senha</label>
                <input type="password" id="confirmarSenha" name="confirmarSenha" placeholder="Digite a senha novamente" required minlength="6">

                <div class="error-message" id="confirmarSenhaError"></div>
            </div>

            <button type="submit" id="submitBtn">Cadastrar</button>
        </form>

        <div>
            <a href="/login">Já possui uma conta? Faça login</a>
        </div>
    </div>

    <script src="/javascripts/register-validation.js"></script>

</body>
</html>