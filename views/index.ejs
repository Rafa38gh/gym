<!DOCTYPE html>
<html lang="pt-br">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/stylesheets/main.css">
    <title><%= title %> - Transforme seu corpo, transforme sua vida</title>
    
  </head>

  <body class="bg-gradient-to-br from-slate-900 via-purple-900 to-slate-900 min-h-screen">
   
    <!-- Navbar -->
    <nav class="bg-black/30 backdrop-blur-md border-b border-white/10 sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16">
          <div class="flex items-center space-x-2">
            <div class="w-10 h-10 bg-gradient-to-br from-purple-500 to-pink-500 rounded-lg flex items-center justify-center">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stoke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
              </svg>
            </div>
            <span class="text-2xl font-bold text-white"><%= title %></span>
          </div>
          <div class="flex items-center space-x-4">
            <a href="/login" class="text-gray-300 hover:text-white transition-colors px-4 py-2 rounded-lg hover:bg-white/10">
              Entrar
            </a>
            <a href="/register" class="bg-gradient-to-r from-purple-500 to-pink-500 text-white px-6 py-2 rounded-lg font semibold hover:shadow-lg hover:shadow-purple-500/50 transition-all">
              Começar Agora
            </a>
          </div>
        </div>
      </div>
    </nav>

    <!-- Hero Section -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 md:py-32">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="space-y-8">
          <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold text-white leadign-tight">
            Transforme seu
            <span class="bg-gradient-to-r from-purple-400 to-pink-400 bg-clip-text text-transparent">
              corpo
            </span>
            e sua vida
          </h1>
          <p class="text-xl text-gray-300 leading-relaxed">
            Monte treinos personalizados, crie dietas sob medida e conecte-se com uma comunidade fitness que vai te motivar todos os dias.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="/register" class="bg-gradient-to-r from-purple-500 to-pink-500 text-white px-8 py-4 rounded-xl font-semibold text-lg hover:shadow-2xl hover:shadow-purple-500/50 transition-all text-center">
              Criar Conta Grátis
            </a>
            <a href="#features" class="border-2 border-white/20 text-white px-8 py-4 rounded-xl font-semibold text-lg hover:bg-white/10 transition-all text-center">
              Conhecer Recursos
            </a>
          </div>
        </div>
        <div class="relative">
          <div class="absolute inset-0 bg-gradient-to-r from-purple-500 to-pink-500 rounded-3xl blur-3xl opacity-30"></div>
          <div class="relative bg-white/10 backdrop-blur-md border border-white/20 rounded-3xl p-8 space-y-6">
            <div class="flex items-center justify-between p-4 bg-white/10 rounded-xl">
              <span class="text-white font-semibold">Treino Hoje</span>
              <span class="bg-green-500 text-white px-3 py-1 rounded-full text-sm">Completo</span>
            </div>
            <div class="flex items-center justify-between p-4 bg-white/10 rounded-xl">
              <span class="text-white font-semibold">Comunidade</span>
              <span class="text-pink-400 font-bold">2.5k membros</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Features -->
     <section id="features" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold text-white mb-4">
          Tudo que você precisa em um só lugar
        </h2>
        <p class="text-xl text-gray-300">
          Ferramentas profissionais para transformar seu corpo
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <!-- Feature 1 -->
        <div class="bg-white/10 backdrop-blur-md border border-white/20 rounded-2xl p-8 hover:bg-white/15 transition-all group">
          <div class="w-16 h-16 bg-gradient-to-br from-purple-500 to-pink-500 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-white mb-4">Treinos Personalizados</h3>
          <p class="text-gray-300">
            Crie e gerencie seus treinos de forma simples. Monte fichas completas com exercícios, séries e repetições.
          </p>
        </div>

        <!-- Feature 2 -->
        <div class="bg-white/10 backdrop-blur-md border border-white/20 rounded-2xl p-8 hover:bg-white/15 transition-all group">
            <div class="w-16 h-16 bg-gradient-to-br from-green-500 to-emerald-500 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
              <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-white mb-4">Dietas Inteligentes</h3>
            <p class="text-gray-300">
              Monte seu plano alimentar personalizado. Controle calorias, macros e refeições de forma prática.
            </p>
        </div>

        <!-- Feature 3 -->
        <div class="bg-white/10 backdrop-blur-md border border-white/20 rounded-2xl p-8 hover:bg-white/15 transition-all group">
          <div class="w-16 h-16 bg-gradient-to-br from-blue-500 to-cyan-500 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-white mb-4">Rede Social Fitness</h3>
          <p class="text-gray-300">
            Compartilhe sua jornada, inspire outros e seja inspirado. Conecte-se com pessoas que têm os mesmos objetivos.
          </p>
        </div>
      </div>
     </section>

     <!-- CTA Section -->
    <section class="mx-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
      <div class="bg-gradient-to-r from-purple-600 to-pink-600 rounded-3xl p-12 md:p-16 text-center">
        <h2 class="text-4xl md:text-5xl font-bold text-white mb-6">
          Pronto para começar sua transformação?
        </h2>
        <p class="text-xl text-white/90 mb-8 max-w-2xl mx-auto">
          Junte-se a milhares de pessoas que já estão alcançando seus objetivos fitness
        </p>
        <a href="/register" class="inline-block bg-white text-purple-600 px-10 py-4 rounded-xl font-bold text-lg hover:shadow-2xl hover:scale-105 transition-all">
          Criar Conta Grátis
        </a>
      </div>
    </section>

    <!-- Footer -->
    <footer class="bg-black/30 backdrop-blur-md border-t border-white/10 mt-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="text-center">
          <div class="flex items-center justify-center space-x-2 mb-4">
            <div class="w-8 h-8 bg-gradient-to-br from-purple-500 to-pink-500 rounded-lg flex items-center justify-center">
              <svg>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
              </svg>
            </div>
            <span class="text-xl font-bold text-white"><%= title %></span>
          </div>
          <p class="text-gray-400">
            © 2025 <%= title %>. Transforme seu corpo, transforme sua vida.
          </p>
        </div>
      </div>
    </footer>

  </body>
</html>
