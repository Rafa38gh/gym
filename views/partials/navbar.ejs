<!-- Navbar -->
<nav class="bg-black/30 backdrop-blur-md border-b border-white/10 sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16">

            <!-- ESQUERDA -->
            <div class="flex items-center space-x-3">

                <% if (user) { %>
                    <!-- Botão da Sidebar -->
                    <button
                        id="toggleSidebar"
                        class="text-gray-300 hover:text-white p-2 rounded-lg hover:bg-white/10 transition"
                        aria-label="Abrir menu"
                    >
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M4 6h16M4 12h16M4 18h16"/>
                        </svg>
                    </button>
                <% } %>

                <!-- Logo -->
                <div class="w-10 h-10 bg-gradient-to-br from-orange-500 to-red-500 rounded-lg flex items-center justify-center">
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M13 10V3L4 14h7v7l9-11h-7z"/>
                    </svg>
                </div>

                <!-- Título -->
                <a href="/" class="text-2xl font-bold text-white">
                    <%= title %>
                </a>
            </div>

            <!-- DIREITA -->
            <div class="flex items-center space-x-4">
                <% if (user) { %>
                    <a href="/dashboard"
                       class="text-gray-300 hover:text-white transition-colors px-4 py-2 rounded-lg hover:bg-white/10">
                        Dashboard
                    </a>
                    <button id="logoutBtn" class="text-red-400 hover:text-red-300">
                        Sair
                    </button>
                <% } else { %>
                    <a href="/login"
                       class="text-gray-300 hover:text-white transition-colors px-4 py-2 rounded-lg hover:bg-white/10">
                        Entrar
                    </a>
                    <a href="/register"
                       class="bg-gradient-to-r from-orange-500 to-red-500 text-white px-6 py-2 rounded-lg font-semibold">
                        Começar Agora
                    </a>
                <% } %>
            </div>

        </div>
    </div>
</nav>
